{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "producthunt": {
      "type": "http",
      "url": "https://mcp.producthunt.com/mcp"
    },
    "actup": {
      "type": "stdio",
      "command": "go",
      "args": ["run", ".", "mcp"]
    },
    "gopls": {
      "type": "stdio",
      "command": "gopls",
      "args": ["mcp"]
    }
  }
}
